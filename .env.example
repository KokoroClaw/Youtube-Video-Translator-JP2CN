# 文件保存路径：留空时使用项目根目录下的 downloads；填写绝对路径可自定义
OUTPUT_DIR=

# OpenAI transcription and translation
TRANSCRIPTION_BACKEND=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_BACKEND=openai
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
TRANSLATION_BATCH_SIZE=50

# ============================================================
# Local Tool Paths (must be absolute paths on Windows)
# ============================================================
FFMPEG_PATH=C:\path\to\miniconda3\envs\subtitle\Library\bin
# Must point to the yt-dlp executable, not only its containing directory.
YTDLP_PATH=C:\path\to\miniconda3\envs\subtitle\Scripts\yt-dlp.exe
YTDLP_JS_RUNTIME=node
YTDLP_FORCE_IPV4=true
YTDLP_PLAYER_CLIENT=web_embedded
BILIUP_PATH=C:\path\to\miniconda3\envs\subtitle\Scripts\biliup.exe

# ============================================================
# Translation API keys
# TRANSLATION_BACKEND=openai uses only OPENAI_API_KEY.
# TRANSLATION_BACKEND=auto selects the first configured backend in this order:
# DeepSeek → OpenAI → MiniMax → Gemini → Groq → Ollama → Anthropic → Zhipu → Google Translate.
# ============================================================
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Ollama (local) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# MiniMax settings
MINIMAX_API_KEY=your_minimax_key_here

# Zhipu AI (智谱) settings
ZHIPU_API_KEY=your_zhipu_key_here
